# Server-only backend origin. Set a real HTTPS backend URL in Vercel.
BACKEND_URL="http://localhost:5000"
# Required in production; match backend values. Never use NEXT_PUBLIC_ for secrets.
APP_ACCESS_USER=""
APP_ACCESS_PASSWORD=""
NEXT_PUBLIC_DEMO_MODE="false"

# Phase 1 private workspaces. Enable both server and client flags together only
# after backend quota schema, owner migration, and two-account isolation review.
GOOGLE_WORKSPACES_ENABLED="false"
NEXT_PUBLIC_GOOGLE_WORKSPACES_ENABLED="false"
# Auth.js v5 Google identity OAuth. Use a separate Web OAuth client from Gmail if desired.
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST="true"
# Same 32+ character server-only value on frontend and backend. Never NEXT_PUBLIC_.
INTERNAL_PROXY_SECRET=""
