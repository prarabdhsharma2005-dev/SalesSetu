// This is your Prisma schema file for SalesSetu
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  salesContext  SalesContext?
  icps          ICP[]
  leads         Lead[]
  companies     Company[]
  contacts      Contact[]
  outreaches    Outreach[]
  meetings      Meeting[]
  deals         Deal[]
  tasks         Task[]
  approvals     Approval[]
  savedSearches SavedSearch[]
  feedbacks     Feedback[]
  integrations  Integration[]
  recommendations AIRecommendation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── ICP & Sales Context ───────────────────────────────────────────────────

model SalesContext {
  id               String   @id @default(cuid())
  userId           String   @unique
  companyName      String
  productService   String   @db.Text
  valueProposition String   @db.Text
  targetIndustries String[]
  geographies      String[]
  companySizeMin   Int?
  companySizeMax   Int?
  buyerPersonas    String[]
  typicalDealSize  String?
  salesObjectives  String   @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ICP {
  id           String   @id @default(cuid())
  userId       String
  name         String
  description  String   @db.Text
  nlQuery      String?  @db.Text
  industries   String[]
  geographies  String[]
  sizeMin      Int?
  sizeMax      Int?
  fundingStage String[]
  intents      String[]
  technologies String[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads Lead[]
}

// ─── Company ───────────────────────────────────────────────────────────────

model Company {
  id                 String   @id @default(cuid())
  userId             String
  name               String
  website            String?
  industry           String?
  country            String?
  state              String?
  city               String?
  employeeCount      Int?
  revenue            String?
  fundingStage       String?
  foundedYear        Int?
  businessModel      String?
  growthStage        String?
  technologies       String[]
  description        String?  @db.Text
  productsServices   String?  @db.Text
  recentDevelopments String?  @db.Text
  hiringSignals      String?  @db.Text
  partnerships       String?  @db.Text
  expansionSignals   String?  @db.Text
  recommendedAngle   String?  @db.Text
  relationshipStatus String   @default("PROSPECT") // PROSPECT, CONTACTED, ENGAGED, CUSTOMER, LOST
  intentStatus       String   @default("COLD")      // HOT, WARM, COLD, INACTIVE
  leadScore          Int?
  whyNowScore        Int?
  isDemo             Boolean  @default(false)
  source             String?
  lastResearched     DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  leads           Lead[]
  intentSignals   IntentSignal[]
  outreaches      Outreach[]
  meetings        Meeting[]
  deals           Deal[]
  activities      Activity[]
  tasks           Task[]
  recommendations AIRecommendation[]
}

// ─── Contact / POC ─────────────────────────────────────────────────────────

model Contact {
  id              String   @id @default(cuid())
  userId          String
  companyId       String
  name            String
  role            String?
  department      String?
  seniority       String?
  email           String?
  emailVerified   Boolean  @default(false)
  phone           String?
  linkedinUrl     String?
  location        String?
  profileSummary  String?  @db.Text
  relevanceReason String?  @db.Text
  source          String?
  confidence      Float?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leads      Lead[]
  outreaches Outreach[]
  meetings   Meeting[]
  deals      Deal[]
  activities Activity[]
  tasks      Task[]
}

// ─── Lead ──────────────────────────────────────────────────────────────────

model Lead {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  contactId      String?
  icpId          String?
  leadScore      Int      @default(0)
  whyNowScore    Int      @default(0)
  scoreBreakdown Json?
  intentType     String?
  status         String   @default("NEW")   // NEW, QUALIFIED, DISQUALIFIED, NURTURE
  stage          String   @default("NEW_LEAD") // NEW_LEAD, QUALIFIED, CONTACTED, ENGAGED, etc.
  nextBestAction String?  @db.Text
  followUpDate   DateTime?
  owner          String?
  notes          String?  @db.Text
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id])
  icp        ICP?        @relation(fields: [icpId], references: [id])
  activities Activity[]
}

// ─── Intent Signal ─────────────────────────────────────────────────────────

model IntentSignal {
  id           String   @id @default(cuid())
  companyId    String
  signalType   String   // HIRING, FUNDING, EXPANSION, PARTNERSHIP, PRODUCT_LAUNCH, etc.
  description  String   @db.Text
  source       String?
  sourceUrl    String?
  evidence     String?  @db.Text
  confidence   Float    @default(0.5)
  detectedDate DateTime @default(now())
  status       String   @default("ACTIVE") // ACTIVE, EXPIRED, VERIFIED
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// ─── Outreach ──────────────────────────────────────────────────────────────

model Outreach {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  contactId      String?
  sequenceId     String?
  channel        String   // EMAIL, LINKEDIN, WHATSAPP, CALL
  subject        String?
  body           String   @db.Text
  callScript     String?  @db.Text
  sequenceStep   Int      @default(1)
  status         String   @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, SENT, REPLIED, BOUNCED
  approvalStatus String   @default("PENDING") // PENDING, APPROVED, REJECTED
  qualityScore   Int?
  qualityChecks  Json?
  sentAt         DateTime?
  responseStatus String?  // POSITIVE, NEUTRAL, NEGATIVE, NO_RESPONSE
  nextFollowUp   DateTime?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact  Contact?          @relation(fields: [contactId], references: [id])
  sequence OutreachSequence? @relation(fields: [sequenceId], references: [id])
  approval Approval?
}

model OutreachSequence {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  steps       Json     // Array of {day, channel, templateId}
  isActive    Boolean  @default(true)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  outreaches Outreach[]
}

// ─── Meeting ───────────────────────────────────────────────────────────────

model Meeting {
  id              String    @id @default(cuid())
  userId          String
  companyId       String
  contactId       String?
  dealId          String?
  title           String
  scheduledAt     DateTime
  duration        Int       @default(60) // minutes
  calendarEventId String?
  meetLink        String?
  agenda          String?   @db.Text
  status          String    @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  outcome         String?   // WON, STRONG_OPPORTUNITY, FOLLOW_UP, PROPOSAL, NEGOTIATION, LOST, NOT_QUALIFIED
  notes           String?   @db.Text
  followUpDate    DateTime?
  prepBrief       Json?
  isDemo          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?     @relation(fields: [contactId], references: [id])
  deal       Deal?        @relation(fields: [dealId], references: [id])
  mom        MeetingMoM?
  activities Activity[]
}

model MeetingMoM {
  id               String   @id @default(cuid())
  meetingId        String   @unique
  objective        String?  @db.Text
  executiveSummary String?  @db.Text
  keyPoints        Json?
  requirements     Json?
  painPoints       Json?
  objections       Json?
  decisions        Json?
  commercialNotes  String?  @db.Text
  actionItems      Json?    // [{task, owner, deadline}]
  nextSteps        String?  @db.Text
  dealStatus       String?
  followUpDate     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// ─── Deal Pipeline ─────────────────────────────────────────────────────────

model Deal {
  id             String    @id @default(cuid())
  userId         String
  companyId      String
  contactId      String?
  name           String
  value          Float?
  probability    Int?
  currency       String    @default("INR")
  stage          String    @default("NEW_LEAD") // NEW_LEAD, QUALIFIED, CONTACTED, ENGAGED, MEETING_SCHEDULED, MEETING_COMPLETED, PROPOSAL, NEGOTIATION, WON, LOST, NURTURE
  health         String    @default("HEALTHY") // HEALTHY, NEEDS_ATTENTION, AT_RISK, STALE
  healthReason   String?
  nextBestAction String?   @db.Text
  nextFollowUp   DateTime?
  owner          String?
  lastActivityAt DateTime?
  closedAt       DateTime?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id])
  meetings   Meeting[]
  tasks      Task[]
  activities Activity[]
}

// ─── Task ──────────────────────────────────────────────────────────────────

model Task {
  id          String    @id @default(cuid())
  userId      String
  companyId   String?
  contactId   String?
  dealId      String?
  title       String
  description String?   @db.Text
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate     DateTime?
  status      String    @default("PENDING") // PENDING, IN_PROGRESS, DONE, CANCELLED
  owner       String?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
}

// ─── Activity Log ──────────────────────────────────────────────────────────

model Activity {
  id              String   @id @default(cuid())
  userId          String?
  companyId       String?
  contactId       String?
  dealId          String?
  meetingId       String?
  leadId          String?
  activityType    String   // LEAD_DISCOVERED, INTENT_DETECTED, POC_IDENTIFIED, OUTREACH_DRAFTED, OUTREACH_SENT, REPLY_RECEIVED, MEETING_BOOKED, MEETING_COMPLETED, MOM_GENERATED, DEAL_STAGE_CHANGED, FOLLOW_UP_CREATED, NOTE_ADDED
  description     String   @db.Text
  source          String   @default("USER") // USER, AI, SYSTEM
  relatedRecordId String?
  metadata        Json?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  contact Contact? @relation(fields: [contactId], references: [id])
  deal    Deal?    @relation(fields: [dealId], references: [id])
  meeting Meeting? @relation(fields: [meetingId], references: [id])
  lead    Lead?    @relation(fields: [leadId], references: [id])
}

// ─── Approval ──────────────────────────────────────────────────────────────

model Approval {
  id          String    @id @default(cuid())
  userId      String
  outreachId  String?   @unique
  actionType  String    // SEND_EMAIL, BOOK_MEETING, DEAL_STAGE_CHANGE, SHARE_MOM
  actionData  Json
  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED, EDITED
  reviewedAt  DateTime?
  reviewNotes String?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  outreach Outreach? @relation(fields: [outreachId], references: [id])
}

// ─── AI Recommendation ─────────────────────────────────────────────────────

model AIRecommendation {
  id             String   @id @default(cuid())
  userId         String
  companyId      String?
  type           String   // OUTREACH, FOLLOW_UP, MEETING, DEAL_ACTION, DAILY_BRIEF
  title          String
  description    String   @db.Text
  priority       String   @default("MEDIUM")
  actionData     Json?
  isDismissed    Boolean  @default(false)
  isActedUpon    Boolean  @default(false)
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
}

// ─── Integration ───────────────────────────────────────────────────────────

model Integration {
  id            String    @id @default(cuid())
  userId        String
  provider      String    // GMAIL, GOOGLE_CALENDAR, GOOGLE_SHEETS
  status        String    @default("DISCONNECTED") // CONNECTED, DISCONNECTED, ERROR
  accessToken   String?   @db.Text
  refreshToken  String?   @db.Text
  expiresAt     DateTime?
  metadata      Json?     // spreadsheetId, calendarId, etc.
  lastSyncAt    DateTime?
  syncStatus    String?   // SYNCED, SYNCING, ERROR
  isDemo        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

// ─── Saved Search ──────────────────────────────────────────────────────────

model SavedSearch {
  id          String    @id @default(cuid())
  userId      String
  name        String
  filters     Json
  isRecurring Boolean   @default(false)
  schedule    String?   // cron expression
  lastRanAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Feedback ──────────────────────────────────────────────────────────────

model Feedback {
  id           String   @id @default(cuid())
  userId       String
  entityType   String   // LEAD, POC, OUTREACH, INTENT, MEETING, DEAL
  entityId     String
  rating       String   // POSITIVE, NEGATIVE, NEUTRAL
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Sales Playbook ────────────────────────────────────────────────────────

model SalesPlaybook {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  industry    String?
  steps       Json     // Array of playbook steps
  templates   Json?    // Associated outreach templates
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
