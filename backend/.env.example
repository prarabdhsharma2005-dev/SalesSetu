PORT=5000
FRONTEND_URL="http://localhost:3000"
GEMINI_API_KEY=""

# Local development uses the existing JSON store. Production requires PostgreSQL.
DATABASE_URL=""
# On Vercel, use the Neon pooled PostgreSQL URL. Locally, leave empty for JSON mode.
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEET_ID=""
TAVILY_API_KEY=""
SALES_SENDER_NAME=""
SALES_SENDER_COMPANY=""
# Optional Gmail OAuth sending. Register this exact callback URI in Google Cloud.
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REDIRECT_URI="http://localhost:5000/api/gmail/oauth/callback"
# Base64 encoding of a random 32-byte key. Keep stable and outside Git.
GMAIL_TOKEN_ENCRYPTION_KEY=""
FOLLOW_UP_SCHEDULER_ENABLED=false
FOLLOW_UP_SCHEDULER_INTERVAL_MS=3600000
# Optional local JSON directory only; never use filesystem storage on Vercel.
DATA_DIR=""
# Vercel cron uses this Bearer secret only when explicitly enabled (32+ characters).
CRON_SECRET=""
# Same single-operator credentials on frontend and backend; password minimum 24 characters
APP_ACCESS_USER=""
APP_ACCESS_PASSWORD=""

# GOOGLE WORKSPACE (OPTIONAL)
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
