{
  "name": "salessetu-backend",
  "version": "1.0.0",
  "description": "SalesSetu - AI Sales Operating System Backend API Service",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "tsc",
    "test:isolated": "node --require ./tests/isolate-env.cjs --test tests/*.test.cjs",
    "start": "node dist/local-server.js",
    "db:prepare-schema": "node scripts/prepare-schema.cjs",
    "db:migrate-local": "node scripts/migrate-local.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
